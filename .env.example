# Khushu data-store deployment. Copy to .env (gitignored); NEVER commit real secrets.
KHUSHU_TURSO_GROUP_TOKEN=
KHUSHU_TURSO_API_TOKEN=

KHUSHU_TURSO_GROUP=khushu
KHUSHU_TURSO_ORG=syedali

# 4 production database endpoints (Turso db names):
KHUSHU_TURSO_DB_QURAN=khushu-quran
KHUSHU_TURSO_DB_TAFSIR=khushu-tafsir
KHUSHU_TURSO_DB_WBW=khushu-wbw
KHUSHU_TURSO_DB_HADITH=khushu-hadith
KHUSHU_TURSO_DB_CONTENT=khushu-content
KHUSHU_TURSO_DB_AUDIO=khushu-audio

# Static asset host (GitHub Release now; R2/CDN later = change base URL only):
KHUSHU_ASSET_REPO=greykaizen/khushu-data-api
KHUSHU_ASSET_REV=v2026.09
# Assets are split into per-kind GitHub releases (GitHub caps 1000 assets/release).
# Resolve: ASSET_URL = https://github.com/$KHUSHU_ASSET_REPO/releases/download/assets-<kind>-$KHUSHU_ASSET_REV/<release_name>
# 'kind' comes from assets.db.assets.kind; the mapping is also in data/manifest/assets.json.
KHUSHU_ASSET_URL_TEMPLATE=https://github.com/greykaizen/khushu-data-api/releases/download/assets-{kind}-v2026.09/{release_name}
