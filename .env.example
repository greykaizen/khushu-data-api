# Khushu data-store deployment. Copy to .env (gitignored); NEVER commit real secrets.
KHUSHU_TURSO_API_TOKEN=          # group-scoped ADMIN API token — CI/build-server ONLY. NEVER ship in the app.
KHUSHU_TURSO_GROUP=khushu
KHUSHU_TURSO_ORG=syedali

# Per-database READ-ONLY tokens (app consumption). Create with:
#   turso db tokens create khushu-<name> --read-only
# Rotate/kill all derived DB tokens with:  turso group tokens invalidate khushu -y
# Read-only tokens only allow SELECT; writes are rejected ("SQL write operations are forbidden").
KHUSHU_TURSO_RO_TOKEN_QURAN=
KHUSHU_TURSO_RO_TOKEN_TAFSIR=
KHUSHU_TURSO_RO_TOKEN_WBW=
KHUSHU_TURSO_RO_TOKEN_HADITH=
KHUSHU_TURSO_RO_TOKEN_CONTENT=
KHUSHU_TURSO_RO_TOKEN_AUDIO=

# libsql:// endpoints (also usable for the app if you point at them directly):
KHUSHU_TURSO_URL_QURAN=libsql://khushu-quran-syedali.aws-us-east-1.turso.io
KHUSHU_TURSO_URL_TAFSIR=libsql://khushu-tafsir-syedali.aws-us-east-1.turso.io
KHUSHU_TURSO_URL_WBW=libsql://khushu-wbw-syedali.aws-us-east-1.turso.io
KHUSHU_TURSO_URL_HADITH=libsql://khushu-hadith-syedali.aws-us-east-1.turso.io
KHUSHU_TURSO_URL_CONTENT=libsql://khushu-content-syedali.aws-us-east-1.turso.io
KHUSHU_TURSO_URL_AUDIO=libsql://khushu-audio-syedali.aws-us-east-1.turso.io

# Turso HTTP query API (no libSQL client needed) — POST https://<url-without-libsql>/v2/pipeline
#   Header: Authorization: Bearer <RO_TOKEN>
#   Body:   {"requests":[{"type":"batch","batch":{"steps":[{"type":"execute","stmt":{"sql":"SELECT ...","args":[]}}]}}]}
#   Field is "sql" (NOT "stmt"); FTS5 MATCH works remotely.

# Static asset host (GitHub Release now; R2/CDN later = change base URL only):
KHUSHU_ASSET_REPO=greykaizen/khushu-data-api
KHUSHU_ASSET_REV=v2026.09
# Assets are split into per-kind GitHub releases (GitHub caps 1000 assets/release).
# Resolve: ASSET_URL = https://github.com/$KHUSHU_ASSET_REPO/releases/download/assets-<kind>-$KHUSHU_ASSET_REV/<release_name>
# 'kind' comes from assets.db.assets.kind; the mapping is also in data/manifest/assets.json.
KHUSHU_ASSET_URL_TEMPLATE=https://github.com/greykaizen/khushu-data-api/releases/download/assets-{kind}-v2026.09/{release_name}
